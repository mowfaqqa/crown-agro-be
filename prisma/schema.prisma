generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  AWAITING_PAYMENT
  PAID
  FULFILLED
  CANCELLED
}

enum Category {
  FRUITS
  GRAINS
  VEGETABLES
  LIVESTOCK
  POULTRY
  FISH
  EQUIPMENT
  PROCESSED_FOODS
}

enum MarketInsightType {
  COMMODITY_PRICE
  AGRICULTURE_NEWS
  EXPORT_OPPORTUNITY
  WEATHER_ADVISORY
}

enum ServiceCategory {
  EQUIPMENT_RENTAL
  JOB_BOARD
  TRAINING
  EXPORT_LOGISTICS
  INPUT_SUPPLY
  WAREHOUSING
  SMART_FARMING
  COMMUNITY
}

enum ServiceEnquiryStatus {
  NEW
  IN_REVIEW
  CONTACTED
  CLOSED
}

enum InvestmentCategory {
  FARMING_SEASON
  FRESH_PRODUCE
  GRAINS
  LIVESTOCK
  EXPORT_LOGISTICS
  WAREHOUSING
  PROCESSING
}

enum InvestorType {
  INDIVIDUAL
  BUSINESS
  INSTITUTION
  NGO
  GOVERNMENT
}

enum InvestmentInterestStatus {
  NEW
  IN_REVIEW
  CONTACTED
  CLOSED
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Customer {
  id                      String                   @id @default(cuid())
  name                    String
  email                   String                   @unique
  passwordHash            String?
  googleId                String?                  @unique
  emailVerifiedAt         DateTime?
  orders                  Order[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  refreshSessions         RefreshSession[]
  serviceEnquiries        ServiceEnquiry[]
  investmentInterests     InvestmentInterest[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
}

model RefreshSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
}

model Seller {
  id        String    @id @default(cuid())
  name      String
  country   String
  verified  Boolean   @default(false)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  description     String
  price           Int
  compareAtPrice  Int?
  currency        String       @default("NGN")
  category        Category
  countryOfOrigin String
  stockQuantity   Int
  unit            String
  imageUrl        String
  halalCertified  Boolean      @default(false)
  exportCertified Boolean      @default(false)
  featured        Boolean      @default(false)
  archivedAt      DateTime?
  sellerId        String
  seller          Seller       @relation(fields: [sellerId], references: [id])
  bulkPricing     BulkPrice[]
  orderItems      OrderItem[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model BulkPrice {
  id          String  @id @default(cuid())
  minQuantity Int
  unitPrice   Int
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerName    String
  email           String
  phone           String
  deliveryCountry String
  deliveryAddress String
  notes           String?
  fulfillmentNotes String?
  status          OrderStatus @default(PENDING)
  paymentProvider String?
  paymentReference String?     @unique
  paymentUrl       String?
  paidAt           DateTime?
  subtotal        Int
  checkoutKey     String?     @unique
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  unitPrice Int
  productId String
  product   Product @relation(fields: [productId], references: [id])
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model MarketInsight {
  id           String            @id @default(cuid())
  title        String
  slug         String            @unique
  summary      String
  content      String
  type         MarketInsightType
  imageUrl     String?
  location     String?
  commodity    String?
  dataValue    String?
  sourceName   String?
  sourceUrl    String?
  featured     Boolean           @default(false)
  publishedAt  DateTime?
  archivedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([type, publishedAt])
}

model ServiceListing {
  id           String            @id @default(cuid())
  title        String
  slug         String            @unique
  summary      String
  description  String
  category     ServiceCategory
  providerName String
  location     String?
  imageUrl     String?
  featured     Boolean           @default(false)
  publishedAt  DateTime?
  archivedAt   DateTime?
  enquiries    ServiceEnquiry[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([category, publishedAt])
}

model ServiceEnquiry {
  id         String               @id @default(cuid())
  serviceId  String
  service    ServiceListing       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phone      String
  message    String
  status     ServiceEnquiryStatus @default(NEW)
  adminNotes String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model InvestmentOpportunity {
  id                    String               @id @default(cuid())
  title                 String
  slug                  String               @unique
  summary               String
  description           String
  category              InvestmentCategory
  location              String?
  imageUrl              String?
  fundingTarget         Int?
  minimumInterestAmount Int?
  durationMonths        Int?
  riskSummary           String
  featured              Boolean              @default(false)
  openForInterest       Boolean              @default(true)
  publishedAt           DateTime?
  archivedAt            DateTime?
  interests             InvestmentInterest[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([category, publishedAt])
}

model InvestmentInterest {
  id               String                   @id @default(cuid())
  opportunityId    String
  opportunity      InvestmentOpportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  investorType     InvestorType
  organizationName String?
  phone            String
  indicativeAmount Int?
  message          String
  status           InvestmentInterestStatus @default(NEW)
  adminNotes       String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([opportunityId, customerId])
  @@index([status, createdAt])
}
